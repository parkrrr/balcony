# At least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
SESSION_SECRET=
# Public origin of the site. Defaults to the request's own host.
# BASE_URL=http://localhost:5173
# Leave unset to keep chat history in memory.
# COSMOS_ENDPOINT=https://<account>.documents.azure.com:443/

# Google sign-in is off by default while the app awaits Google's verification; guests pick a name instead.
# To turn it on, set GOOGLE_SIGN_IN=on and fill in a Google OAuth client (Web application) whose
# authorized redirect URIs include http://localhost:5173/auth/callback.
# GOOGLE_SIGN_IN=on
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
